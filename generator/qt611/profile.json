    {"name": "Multimedia", "qt_modules": ["QtMultimedia", "QtMultimediaWidgets", "QtSpatialAudio", "QtTextToSpeech"]},
    {"name": "Qt3D", "qt_modules": ["Qt3DAnimation", "Qt3DCore", "Qt3DExtras", "Qt3DInput", "Qt3DLogic", "Qt3DRender"]},
    {"name": "Pdf", "qt_modules": ["QtPdf", "QtPdfWidgets"]},
    {"name": "Designer", "qt_modules": ["QtDesigner", "QtUiTools", "QtHelp"]},
    {"name": "Location", "qt_modules": ["QtLocation", "QtPositioning"]},
    {"name": "Connectivity", "qt_modules": ["QtBluetooth", "QtNfc", "QtSerialPort", "QtSerialBus", "QtSensors"]},
    {
      "name": "CanvasPainter",
      "separate_headers": true,
      "qt_modules": [
        "QtCanvasPainter"
      ]
    },
    {
      "name": "Graphs",
      "qt_modules": [
        "QtGraphs",
        "QtGraphsWidgets"
      ]
    },
    {
      "name": "HttpServer",
      "qt_modules": [
        "QtHttpServer"
      ]
    },
    {
      "name": "NetworkAuth",
      "qt_modules": [
        "QtNetworkAuth"
      ]
    },
    {
      "name": "Quick3D",
      "qt_modules": [
        "QtQuick3D"
      ]
    },
    {
      "name": "Charts",
      "qt_modules": [
        "QtCharts"
      ],
      "separate_headers": true,
      "namespaces": {
        "PySide6.QtCharts": "Charts"
      }
    },
    {
      "name": "DataVisualization",
      "qt_modules": [
        "QtDataVisualization"
      ],
      "separate_headers": true,
      "namespaces": {
        "PySide6.QtDataVisualization": "DataVisualization"
      }
    }
  ],
  "exclude_methods": {},
  "limited_abi": true
}
